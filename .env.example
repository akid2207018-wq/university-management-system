# Copy this file to .env and replace all development-only values before use.

POSTGRES_DB=university
POSTGRES_USER=university
POSTGRES_PASSWORD=replace-with-a-strong-database-password
APP_PORT=8080

# Must be at least 32 bytes. Use a long random value in any real deployment.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=3600000

BOOTSTRAP_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
BOOTSTRAP_TEACHER_USERNAME=teacher
BOOTSTRAP_TEACHER_PASSWORD=replace-with-a-strong-teacher-password
BOOTSTRAP_STUDENT_USERNAME=student
BOOTSTRAP_STUDENT_PASSWORD=replace-with-a-strong-student-password
